{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the app's own commands, listening to their events and the folder picker, nothing else",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-storage-status",
    "allow-list-workflows",
    "allow-get-workflow",
    "allow-validate-workflow",
    "allow-preview-name",
    "allow-create-workflow",
    "allow-update-workflow",
    "allow-delete-workflow",
    "allow-set-workflow-enabled",
    "allow-reorder-workflows",
    "allow-preview-workflow-on-file",
    "allow-run-workflow-on-file",
    "allow-account-status",
    "allow-sign-in",
    "allow-sign-up",
    "allow-sign-out",
    "allow-request-password-reset"
  ]
}
